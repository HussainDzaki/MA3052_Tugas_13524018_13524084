<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ma3052.controller.GraphVisualGUIController">
    
    <!-- Center: HBox with Left Menu and Right Canvas+Log -->
    <center>
        <HBox spacing="15">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            
            <!-- LEFT: Control Menu -->
            <VBox prefWidth="380" spacing="12" style="-fx-border-color: #ddd; -fx-border-width: 0 1 0 0;">
                <padding>
                    <Insets right="15" />
                </padding>
                
                <!-- Node Management Section -->
                <VBox fx:id="addNodeVbox" spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1976d2;" text="Add Node" />
                    <HBox spacing="8">
                        <TextField fx:id="nodeInput" prefWidth="200.0" promptText="Enter node name" />
                        <Button fx:id="addNodeButton" onAction="#handleAddNode" minWidth="80.0" style="-fx-padding: 8; -fx-font-weight: bold;" stylesheets="@GUI.css" text="Add" />
                    </HBox>
                </VBox>
                
                <!-- Separator -->
                <Separator />
                
                <!-- Edge Management Section -->
                <VBox spacing="8">
                    <Label fx:id="labelAddEdge" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1976d2;" text="Add Edge" />
                    <HBox spacing="8">
                        <TextField fx:id="edgeStartInput" prefWidth="120.0" promptText="Start" />
                        <TextField fx:id="edgeEndInput" prefWidth="120.0" promptText="End" />
                        <Button fx:id="addEdgeButton" onAction="#handleAddEdge" minWidth="60.0" style="-fx-padding: 8; -fx-font-weight: bold;" stylesheets="@GUI.css" text="Add" />
                    </HBox>
                    <Button fx:id="clearButton" onAction="#handleClear" maxWidth="Infinity" style="-fx-padding: 10; -fx-text-fill: #d32f2f; -fx-font-weight: bold;" text="Clear Graph" />
                    <Button fx:id="advancedInput" onAction="#handleAdvancedInput" maxWidth="Infinity" style="-fx-padding: 8; -fx-font-weight: bold;" stylesheets="@GUI.css" text="Advanced Input" />
                </VBox>
                
                <!-- Separator -->
                <Separator />
                
                <!-- Algorithm Execution Section -->
                <VBox spacing="8">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #388e3c;" text="Algorithm" />
                    
                    <Label style="-fx-font-size: 11;" text="Algorithm Type:" />
                    <ComboBox fx:id="algorithmCombo" prefWidth="Infinity" />

                    <Label fx:id="labelStartNode" style="-fx-font-size: 11;" text="Start Node:" />
                    <TextField fx:id="startNodeInput" promptText="Enter starting node" />

                    <Label fx:id="labelEndNode" style="-fx-font-size: 11;" text="End Node:" />
                    <TextField fx:id="endNodeInput" promptText="Enter ending node" />
                    
                    <Label fx:id="labelSpeedSlider" style="-fx-font-size: 11;" text="Speed:" />
                    <Slider fx:id="speedSlider" max="2000.0" min="100.0" showTickLabels="false" value="500.0" />
                    
                    <Button fx:id="executeButton" maxWidth="Infinity" onAction="#handleExecuteAlgorithm" style="-fx-padding: 12; -fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #ffffff; -fx-background-color: #388e3c;" stylesheets="@GUI.css" text="Execute" />
                </VBox>
                
                <VBox VBox.vgrow="ALWAYS" />
            </VBox>
            
            <!-- RIGHT: Canvas and Log -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                
                <!-- Canvas Section -->
                <VBox prefHeight="400.0" spacing="5" VBox.vgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #0d47a1;" text="Graph Visualization" />
                    <Canvas fx:id="graphCanvas" height="400.0" style="-fx-border-color: #999; -fx-border-width: 1;" width="640.0" VBox.vgrow="ALWAYS" />
                </VBox>
                
                <!-- Log Section -->
                <VBox prefHeight="150.0" spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #558b2f;" text="Execution Log" />
                    <TextArea fx:id="logArea" editable="false" style="-fx-font-family: 'Courier New'; -fx-font-size: 10; -fx-control-inner-background: #f9f9f9;" wrapText="true" VBox.vgrow="ALWAYS" />
                </VBox>
            </VBox>
        </HBox>
    </center>
   <top>
      <VBox prefHeight="109.0" prefWidth="1075.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="122.0" prefWidth="1074.0" style="-fx-font-size: 40; -fx-font-style: bold;" stylesheets="@GUI.css" text="Graph Visualization" textAlignment="CENTER" VBox.vgrow="SOMETIMES" />
            <HBox prefHeight="45.0" prefWidth="1075.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="btnNodeAndEdges" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchToNodeAndEdges" prefHeight="86.0" prefWidth="150.0" text="Node and Edges" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnSwitchToGrid" alignment="CENTER" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchToGrid" prefHeight="86.0" prefWidth="150.0" text="Grid" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
    
</BorderPane>
